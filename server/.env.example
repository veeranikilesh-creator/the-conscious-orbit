# Copy to .env and fill in. Never commit .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/conscious-orbit
CORS_ORIGIN=http://localhost:5173

# Module 7 — AI decision engine. Without this the endpoint returns a
# deterministic heuristic verdict instead of a model-generated one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Module 6 — SpyFu competitor/keyword analysis. Without these the integration
# returns clearly-labelled placeholder data instead of failing.
SPYFU_API_ID=
SPYFU_SECRET_KEY=

# Email — SMTP config for sending report DOCX to users after admin approval.
# Without these, emails are logged but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Conscious Orbit" <reports@consciousorbit.com>
